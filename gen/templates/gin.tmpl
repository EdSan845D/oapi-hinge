{{- .Header}}
package {{.Pkg}}

import (
	{{.ImportBlock}}
	"github.com/gin-gonic/gin"
	"github.com/EdSan845D/oapi-hinge/servergin"
)

{{range .Owners -}}
// Register{{.Name}}{{$.Target.Title}} 把 {{.Name}} 的全部端点挂到 {{$.Target.Title}}。
func Register{{.Name}}{{$.Target.Title}}(i gin.IRouter, k *hinge.Kernel{{if not .IsPkg}}, ep {{.OwnerAlias}}.{{.Name}}{{end}}) {
{{- if .HasGroup}}
	r := i.Group("", {{.GroupArgs}})
{{- else}}
	r := i
{{- end}}
{{- $isPkg := .IsPkg}}
{{- $ownerAlias := .OwnerAlias}}
{{- range .Eps}}
	r.{{.Method}}("{{.Path}}"{{if ne .Args ""}}, {{.Args}}{{end}}, servergin.Handle(k, {{.Spec}}, {{.Binder}}, func(ctx context.Context, q, b any) (any, error) {
		return {{if $isPkg}}{{$ownerAlias}}{{else}}ep{{end}}.{{.Handler}}(ctx, q{{if ne .QName ""}}.({{$ownerAlias}}.{{.QName}}){{end}}{{if not .TwoArg}}, b.({{$ownerAlias}}.{{.BName}}){{end}})
	}))
{{- end}}
}

{{end -}}
// RegisterAll{{.Target.Title}} 一次装配全部端点（{{.Target.Title}}）。
func RegisterAll{{.Target.Title}}(i gin.IRouter, k *hinge.Kernel, all All) {
{{- range .Owners}}
	Register{{.Name}}{{$.Target.Title}}(i, k{{if not .IsPkg}}, all.{{.Name}}{{end}})
{{- end}}
}