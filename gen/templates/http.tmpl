{{- .Header}}
package {{.Pkg}}

import (
	{{.ImportBlock}}
	"net/http"
	"github.com/EdSan845D/oapi-hinge/serverhttp"
)

{{range .Owners -}}
// Register{{.Name}}{{$.Target.Title}} 把 {{.Name}} 的全部端点挂到 {{$.Target.Title}}。
func Register{{.Name}}{{$.Target.Title}}(i *http.ServeMux, k *hinge.Kernel{{if not .IsPkg}}, ep {{.OwnerAlias}}.{{.Name}}{{end}}) {
{{- $isPkg := .IsPkg}}
{{- $ownerAlias := .OwnerAlias}}
{{- range .Eps}}
	i.HandleFunc("{{.Method}} {{.Path}}", serverhttp.Handle(k, {{.Spec}}, {{.Binder}}, func(ctx context.Context, q, b any) (any, error) {
		return {{if $isPkg}}{{$ownerAlias}}{{else}}ep{{end}}.{{.Handler}}(ctx{{if gt .ArgNums 0}}, q{{if ne .QName ""}}.({{$ownerAlias}}.{{.QName}}){{end}}{{end}}{{if eq .ArgNums 2}}, b.({{$ownerAlias}}.{{.BName}}){{end}})
	}{{if ne .Args ""}}, {{.Args}}{{end}}))
{{- end}}
}

{{end -}}
// RegisterAll{{.Target.Title}} 一次装配全部端点（{{.Target.Title}}）。
func RegisterAll{{.Target.Title}}(i *http.ServeMux, k *hinge.Kernel, all All) {
{{- range .Owners}}
	Register{{.Name}}{{$.Target.Title}}(i, k{{if not .IsPkg}}, all.{{.Name}}{{end}})
{{- end}}
}

