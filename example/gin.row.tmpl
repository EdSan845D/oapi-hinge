{{- .Header}}
package {{.Pkg}}

import (
    "io"
	"mime/multipart"
	"net/http"
	{{.ImportBlock}}

	"github.com/gin-gonic/gin"
)

type Reader struct {
	C *gin.Context
}

func (r *Reader) Context() context.Context { return r.C.Request.Context() }

func (r *Reader) Method() string { return r.C.Request.Method }

func (r *Reader) PathParam(name string) (string, bool) {
	v := r.C.Param(name)
	return v, v != ""
}

func (r *Reader) QueryValues(name string) ([]string, bool) {
	vals := r.C.QueryArray(name)
	return vals, len(vals) > 0
}

func (r *Reader) FormValues(name string) ([]string, bool) {
	if err := r.C.Request.ParseForm(); err != nil {
		return nil, false
	}
	vals := r.C.Request.PostForm[name]
	return vals, len(vals) > 0
}

func (r *Reader) Header(name string) (string, bool) {
	v := r.C.GetHeader(name)
	return v, v != ""
}

func (r *Reader) Cookie(name string) (string, bool) {
	v, err := r.C.Cookie(name)
	if err != nil || v == "" {
		return "", false
	}
	return v, true
}

func (r *Reader) Body() ([]byte, error) {
	if r.C.Request.Body == nil {
		return nil, nil
	}
	return io.ReadAll(r.C.Request.Body)
}

func (r *Reader) MultipartForm() (*multipart.Form, error) {
	// 标准库对已解析请求为空操作；内存缓冲水位固定 32MB
	if err := r.C.Request.ParseMultipartForm(32 << 20); err != nil {
		return nil, err
	}
	return r.C.Request.MultipartForm, nil
}

// Sink hinge.Sink 实现（拦截器短路写出口径）：written 标志防短路后重复输出。
type Sink struct {
	C       *gin.Context
	written bool
}

func (s *Sink) SetStatus(code int)               { s.C.Status(code) }
func (s *Sink) SetHeader(k, v string)            { s.C.Header(k, v) }
func (s *Sink) AddCookie(c *http.Cookie)         { http.SetCookie(s.C.Writer, c) }
func (s *Sink) WriteJSON(status int, v any)      { s.written = true; s.C.JSON(status, v) }

// WriteStream 二进制流（FileStream）：row 模板的极简形态不做 Range/条件请求，
// 复制 Reader 全量输出；需要 Range 语义请用内置模板（内核 writeStreamFile）。
func (s *Sink) WriteStream(f *hinge.FileStream) {
	if f == nil || f.Reader == nil {
		s.C.String(http.StatusInternalServerError, "invalid file stream")
		return
	}
	s.written = true
	if f.ContentType != "" {
		s.C.Header("Content-Type", f.ContentType)
	}
	s.C.Status(http.StatusOK)
	_, _ = io.Copy(s.C.Writer, f.Reader)
}

// Adaptor 极简管线（row 模板自足形态）：绑定 + 内核拦截链 + 输出。
// 拦截链语义与内核 HandleWith 对齐：ICs 按声明序包裹（先根后叶的合成序由
// 发射器保证），短路拦截器经 Sink 自行写出（written 防重复输出）；
// 返回错误走 500。
func Adaptor(ep hinge.Endpoint, bindQ hinge.Binder, bindB hinge.Binder, h hinge.HandlerFunc, ics ...hinge.Interceptor) gin.HandlerFunc {
	return func(c *gin.Context) {
		var qv, bv any
		if bindQ != nil {
			v, err := bindQ(c, &Reader{C: c})
			if err != nil {
				c.AbortWithError(http.StatusBadRequest, err)
				return
			}
			qv = v
		}
		if bindB != nil {
			v, err := bindB(c, &Reader{C: c})
			if err != nil {
				c.AbortWithError(http.StatusBadRequest, err)
				return
			}
			bv = v
		}
		rd := &Reader{C: c}
		sn := &Sink{C: c}
		var out any
		call := func(ctx context.Context) error {
			var err error
			out, err = h(ctx, qv, bv)
			return err
		}
		for i := len(ics) - 1; i >= 0; i-- {
			ic, next := ics[i], call
			call = func(ctx context.Context) error {
				return ic(ctx, ep, rd, sn, next)
			}
		}
		if err := call(c.Request.Context()); err != nil {
			c.AbortWithError(http.StatusInternalServerError, err)
			return
		}
		if !sn.written {
			c.JSON(http.StatusOK, out)
		}
	}
}

{{range .Owners -}}
// Register{{.Name}}{{$.Target.Title}} 把 {{.Name}} 的全部端点挂到 {{$.Target.Title}}。
func Register{{.Name}}{{$.Target.Title}}(i gin.IRouter{{if not .IsPkg}}, ep {{.OwnerAlias}}.{{.Name}}{{end}}) {
{{- if .HasGroup}}
	r := i.Group("", {{.GroupArgs}})
{{- else}}
	r := i
{{- end}}
{{- $isPkg := .IsPkg}}
{{- $ownerAlias := .OwnerAlias}}
{{- range .Eps}}
	r.{{.Method}}("{{.Path}}"{{if ne .Args ""}}, {{.Args}}{{end}}, Adaptor({{.EPLit}}, {{.Binder}}, func(ctx context.Context, q, b any) (any, error) {
		return {{if $isPkg}}{{$ownerAlias}}{{else}}ep{{end}}.{{.Handler}}(ctx{{if gt .ArgNums 0}}, q{{if ne .QName ""}}.({{$ownerAlias}}.{{.QName}}){{end}}{{end}}{{if eq .ArgNums 2}}, b.({{$ownerAlias}}.{{.BName}}){{end}})
	}{{.Extras}}))
{{- end}}
}

{{end -}}
// RegisterAll{{.Target.Title}} 一次装配全部端点（{{.Target.Title}}）。
func RegisterAll{{.Target.Title}}(i gin.IRouter, all All) {
{{- range .Owners}}
	Register{{.Name}}{{$.Target.Title}}(i{{if not .IsPkg}}, all.{{.Name}}{{end}})
{{- end}}
}